<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>9.0</LangVersion>
    <RootNamespace>AssimpInsideAlibreDesignAddon</RootNamespace>
    <TargetFramework>net481</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="AlibreAddOn - Copy\**" />
    <Compile Remove="Examples\**" />
    <Compile Remove="icons\**" />
    <EmbeddedResource Remove="AlibreAddOn - Copy\**" />
    <EmbeddedResource Remove="Examples\**" />
    <EmbeddedResource Remove="icons\**" />
    <None Remove="AlibreAddOn - Copy\**" />
    <None Remove="Examples\**" />
    <None Remove="icons\**" />
    <Page Remove="AlibreAddOn - Copy\**" />
    <Page Remove="Examples\**" />
    <Page Remove="icons\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="alibre-shapes-addon.adc" />
    <None Remove="Scripts\src\hss\Template.py" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="alibre-shapes-addon.adc">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Scripts\src\hss\Template.py">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <None Include="AlibreAddOn.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="IronPython" Version="3.4.2" />
    <PackageReference Include="IronPython.StdLib" Version="3.4.2" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="AlibreAddOn">
      <HintPath>C:\Program Files\Alibre Design 28.1.1.28227\Program\AlibreAddOn.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="AlibreX">
      <HintPath>C:\Program Files\Alibre Design 28.1.1.28227\Program\AlibreX.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Update="alibre-stltostp-addon.adc">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Update="config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>