<AlibreDesignAddOn specificationVersion="2" friendlyName="$safeprojectname$">
<Author name="$username$" link="$projecturl$"/>
   <Copyright>Copyright (c) $year$ $username$</Copyright>
   <DLL type="Managed" loadedWhen="Startup" location="$projectname$.dll"/>
   <Icon location=""/> 
   <Menu text="$safeprojectname$"/>
   <Description>$projectdescription$</Description> 
   <Workspace type="Always"/>
   <Property name="Identifier" value="$safeprojectname$"/>
</AlibreDesignAddOn>